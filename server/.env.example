# Copy to server/.env (git ignores it) and run:
#   uvicorn main:app --reload --port 8000 --env-file .env

# Accounts (card 13). Supabase dashboard > Project Settings > API Keys.
# The secret key (sb_secret_...) can read and delete every account's data:
# keep it out of the browser, GitHub, and chat.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# Supabase user ids (Authentication > Users) that get the admin role.
ADMIN_USER_IDS=

# Optional: a fine-grained GitHub token with Actions read and write on this
# repo, for the admin's "Start data refresh" button.
GH_REFRESH_TOKEN=
