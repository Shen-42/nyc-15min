# Copy the lines you need into client/.env.local (git ignores it).

# Stadia Maps key, so map tiles load fully on localhost (see README).
VITE_STADIA_API_KEY=

# Sign-in (card 13): Supabase dashboard > Project Settings > API Keys.
# The publishable key (sb_publishable_...) is safe in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
